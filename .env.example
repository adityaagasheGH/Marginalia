# ─────────────────────────────────────────────────────────────
# Marginalia — environment variables
#
# Copy to .env and fill in. .env is gitignored; never commit it.
# No variable here may be prefixed NEXT_PUBLIC_ unless it is
# genuinely public — that prefix inlines the value into the
# client bundle.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Neon Postgres. The pooled URL is used at runtime; the direct
# URL is required for Prisma migrations (pgbouncer can't run DDL).
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── LLM & Embeddings: Google Gemini (completely free) ───────
# aistudio.google.com → Get API key. No credit card required.
# Free tier: 1,500 requests/day, 10M tokens/minute (no expiry).
#
# Models:
#   - gemini-2.5-flash: all text generation
#     (chat answers, summaries, map-reduce, query condensation)
#   - gemini-embedding-001: retrieval embeddings (768 dimensions)
#
# All calls share one quota pool. You won't hit limits during
# development or demo recording — the free tier is plenty.
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── File storage: Vercel Blob ───────────────────────────────
# Vercel dashboard → Storage → Blob → connect → copy token
BLOB_READ_WRITE_TOKEN=""

# ── Rate limiting (optional) ────────────────────────────────
# Rate limiting uses in-memory sliding window by default.
# This is fine for a four-day sprint and small demo audience.
#
# For production, add Upstash Redis to the stack:
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
# Without these, in-memory limits are used instead.
