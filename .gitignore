# ── Secrets ──────────────────────────────────────────────────
# Everything .env* EXCEPT the committed template.
# The "!" prefix means "un-ignore this one".
.env
.env.*
!.env.example

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*

# ── Next.js build output ─────────────────────────────────────
.next/
.next-dev/
out/
build/
next-env.d.ts

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ── Testing / coverage ───────────────────────────────────────
coverage/

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
